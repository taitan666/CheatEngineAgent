{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/agentos/lease.schema.json",
  "title": "Lease",
  "type": "object",
  "required": ["id", "task_id", "actor_id", "epoch", "scope", "issued_at", "expires_at", "status"],
  "properties": {
    "id": {"type": "string"}, "task_id": {"type": "string"}, "actor_id": {"type": "string"},
    "epoch": {"type": "integer", "minimum": 1}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "process_identity_ref": {"type": ["string", "null"]}, "status": {"enum": ["active", "expired", "revoked"]}
  }, "additionalProperties": false
}
