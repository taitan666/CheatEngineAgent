{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/agentos/approval.schema.json",
  "title": "Approval contracts",
  "$defs": {
    "request": {"type": "object", "required": ["id", "action", "target_ref", "parameter_hash", "object_hash", "policy_snapshot_ref", "expires_at", "max_uses"], "properties": {"id": {"type": "string"}, "action": {"type": "string"}, "target_ref": {"type": "string"}, "parameter_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "object_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "policy_snapshot_ref": {"type": "string"}, "expires_at": {"type": "string", "format": "date-time"}, "max_uses": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "decision": {"type": "object", "required": ["id", "request_ref", "request_hash", "approver_id", "decision", "decided_at"], "properties": {"id": {"type": "string"}, "request_ref": {"type": "string"}, "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "approver_id": {"type": "string"}, "decision": {"enum": ["approved", "denied", "revoked"]}, "decided_at": {"type": "string", "format": "date-time"}}, "additionalProperties": false}
  },
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/decision"}]
}
