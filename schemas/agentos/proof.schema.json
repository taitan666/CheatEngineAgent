{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/agentos/proof.schema.json",
  "title": "Proof", "type": "object",
  "required": ["id", "subject_ref", "subject_version", "content_hash", "input_hash", "validator_id", "validator_version", "policy_snapshot_ref", "evidence_refs", "verified_at", "result"],
  "properties": {"id": {"type": "string"}, "subject_ref": {"type": "string"}, "subject_version": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "validator_id": {"type": "string"}, "validator_version": {"type": "string"}, "policy_snapshot_ref": {"type": "string"}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "verified_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": ["string", "null"], "format": "date-time"}, "result": {"enum": ["pass", "fail", "inconclusive"]}},
  "additionalProperties": false
}
