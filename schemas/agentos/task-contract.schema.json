{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/agentos/task-contract.schema.json",
  "title": "TaskContract",
  "type": "object",
  "required": ["id", "version", "schema_version", "request_ref", "requirements", "constraints", "acceptance", "authority_scope", "content_hash"],
  "properties": {
    "id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
    "schema_version": {"const": "1.0"}, "request_ref": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string"}, "text": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "required", "validator"], "properties": {"id": {"type": "string"}, "required": {"type": "boolean"}, "validator": {"type": "string"}}, "additionalProperties": false}},
    "authority_scope": {"type": "array", "items": {"type": "string"}},
    "supersedes_ref": {"type": ["string", "null"]}, "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
