{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/agentos/resolved-execution-manifest.schema.json",
  "title": "ResolvedExecutionManifest",
  "type": "object",
  "required": ["id", "task_id", "task_contract_version", "runtime_profile", "feature_set_ref", "resolved_features", "adapter_versions", "policy_snapshot_ref", "lease_ref", "content_hash"],
  "properties": {
    "id": {"type": "string"}, "task_id": {"type": "string"}, "task_contract_version": {"type": "integer", "minimum": 1},
    "runtime_profile": {"enum": ["lite", "standard", "durable"]}, "feature_set_ref": {"type": "string"},
    "resolved_features": {"type": "array", "items": {"type": "string"}}, "adapter_versions": {"type": "object"},
    "policy_snapshot_ref": {"type": "string"}, "lease_ref": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }, "additionalProperties": false
}
