{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/agentos/task.schema.json",
  "title": "Task",
  "type": "object",
  "required": ["id", "schema_version", "task_contract_ref", "execution_status", "outcome", "epoch", "budget"],
  "properties": {
    "id": {"type": "string", "minLength": 1}, "schema_version": {"const": "1.0"},
    "task_contract_ref": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "execution_status": {"enum": ["created", "queued", "claimed", "running", "waiting", "verifying", "recovering", "canceling", "finished"]},
    "outcome": {"type": ["string", "null"], "enum": [null, "succeeded", "partial_success", "failed", "canceled", "expired"]},
    "wait_reason": {"type": ["string", "null"], "enum": [null, "approval", "resource", "external", "blocked"]},
    "epoch": {"type": "integer", "minimum": 1}, "budget": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"execution_status": {"const": "finished"}}}, "then": {"properties": {"outcome": {"not": {"type": "null"}}}}},
    {"if": {"properties": {"execution_status": {"not": {"const": "finished"}}}}, "then": {"properties": {"outcome": {"type": "null"}}}}
  ],
  "additionalProperties": false
}
