{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/ui-schema/layout.schema.json",
  "title": "UI schema layout (page of whitelisted components)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "page_title", "sections"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "page_title": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "components"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "component.schema.json"}
          }
        }
      }
    }
  }
}
