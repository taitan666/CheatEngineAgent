{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/ui-schema/component.schema.json",
  "title": "UI schema component (whitelisted)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "access"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {
      "enum": ["text", "value_card", "progress_bar", "toggle", "slider",
        "dropdown", "item_grid", "table", "search_box", "status_notice"]
    },
    "title": {"type": "string", "minLength": 1},
    "field_id": {"type": "string"},
    "access": {"enum": ["read_only", "editable"]},
    "options_json": {"type": "string"}
  }
}
