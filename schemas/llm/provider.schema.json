{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/llm/provider.schema.json",
  "title": "ProviderConfiguration", "type": "object",
  "required": ["id", "adapter", "endpoint", "model", "secret_ref", "timeout_ms", "max_prompt_bytes", "max_rag_bytes", "max_output_tokens", "max_total_tokens", "enabled"],
  "properties": {
    "id": {"type": "string"},
    "adapter": {"const": "openai_compatible"},
    "endpoint": {"type": "string", "format": "uri"},
    "model": {"type": "string", "minLength": 1},
    "secret_ref": {"type": "string", "pattern": "^(windows-credential-manager|environment):"},
    "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 300000},
    "max_prompt_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "max_rag_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 65536},
    "max_total_tokens": {"type": "integer", "minimum": 1, "maximum": 262144},
    "enabled": {"type": "boolean"}
  },
  "additionalProperties": false
}
