{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/ce-domain/memory.schema.json",
  "title": "CE memory contracts",
  "$defs": {
    "range": {"type": "object", "required": ["start", "size"], "properties": {"start": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"}, "size": {"type": "integer", "minimum": 1, "maximum": 1048576}}, "additionalProperties": false},
    "readRequest": {"type": "object", "required": ["task_id", "process_identity_ref", "lease_ref", "address", "byte_count"], "properties": {"task_id": {"type": "string"}, "process_identity_ref": {"type": "string"}, "lease_ref": {"type": "string"}, "address": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"}, "byte_count": {"type": "integer", "minimum": 1, "maximum": 65536}}, "additionalProperties": false},
    "writeRequest": {"type": "object", "required": ["task_id", "process_identity_ref", "lease_ref", "approval_ref", "address", "expected_original_bytes", "replacement_bytes", "idempotency_key"], "properties": {"task_id": {"type": "string"}, "process_identity_ref": {"type": "string"}, "lease_ref": {"type": "string"}, "approval_ref": {"type": "string"}, "address": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"}, "expected_original_bytes": {"type": "string", "pattern": "^([0-9A-Fa-f]{2})+$"}, "replacement_bytes": {"type": "string", "pattern": "^([0-9A-Fa-f]{2})+$"}, "idempotency_key": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "result": {"type": "object", "required": ["result", "receipt_ref", "readback_hash"], "properties": {"result": {"enum": ["applied", "rejected", "unknown"]}, "receipt_ref": {"type": "string"}, "readback_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}
  },
  "oneOf": [{"$ref": "#/$defs/range"}, {"$ref": "#/$defs/readRequest"}, {"$ref": "#/$defs/writeRequest"}, {"$ref": "#/$defs/result"}]
}
