{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/ce-domain/scan.schema.json",
  "title": "CE scan contracts",
  "type": "object",
  "required": ["task_id", "process_identity_ref", "lease_ref", "scan_kind", "ranges", "budget", "epoch"],
  "properties": {
    "task_id": {"type": "string"}, "process_identity_ref": {"type": "string"}, "lease_ref": {"type": "string"},
    "scan_kind": {"enum": ["value", "aob"]}, "value_type": {"enum": ["byte", "word", "dword", "qword", "single", "double"]},
    "scope_id": {"type": "string", "minLength": 1},
    "value": {"type": ["string", "number", "integer", "null"]}, "aob_pattern": {"type": ["string", "null"]},
    "expected_match_count": {"type": ["integer", "null"], "minimum": 1},
    "ranges": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "required": ["start", "size"], "properties": {"start": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"}, "size": {"type": "integer", "minimum": 1, "maximum": 536870912}}, "additionalProperties": false}},
    "budget": {"type": "object", "required": ["max_bytes", "max_results"], "properties": {"max_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}, "max_results": {"type": "integer", "minimum": 1, "maximum": 10000}, "max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 30000}, "max_regions": {"type": "integer", "minimum": 1, "maximum": 4096}}, "additionalProperties": false},
    "epoch": {"type": "integer", "minimum": 1}
  }, "allOf": [
    {"if": {"properties": {"scan_kind": {"const": "value"}}, "required": ["scan_kind"]},
     "then": {"required": ["value_type", "value", "scope_id"]}}
  ], "additionalProperties": false
}
