{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/state-model/field.schema.json",
  "title": "Game state field model",
  "type": "object",
  "additionalProperties": false,
  "required": ["field_id", "display_name", "value_type", "source", "access", "validation_status", "last_updated"],
  "properties": {
    "field_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "value_type": {"enum": ["integer", "single", "bool", "enum", "string"]},
    "value_json": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "access": {"enum": ["read_only", "pending_write", "verified_writable", "invalid"]},
    "validation_status": {"enum": ["observed", "hypothesis", "user_confirmed", "verified"]},
    "last_updated": {"type": "string", "format": "date-time"},
    "constraints_json": {"type": "string"},
    "evidence_refs_json": {"type": "string"}
  }
}
