{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/state-model/game-state.schema.json",
  "title": "Game state model",
  "type": "object",
  "additionalProperties": false,
  "required": ["game_name", "executable_sha256", "fields"],
  "properties": {
    "game_name": {"type": "string", "minLength": 1},
    "game_version": {"type": "string"},
    "executable_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "module_set_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fields": {
      "type": "array",
      "items": {"$ref": "field.schema.json"}
    }
  }
}
