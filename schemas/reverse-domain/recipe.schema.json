{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/reverse-domain/recipe.schema.json",
  "title": "Authority-free Reverse Recipe",
  "description": "A recipe never carries an approval, lease, token, effect authority, or executable permission.",
  "type": "object",
  "required": ["id", "schema_version", "name", "compatibility_hash", "source_evidence_refs", "required_capabilities", "location_strategy", "verification_plan", "known_failure_modes"],
  "properties": {
    "id": {"$ref": "../common/definitions.schema.json#/$defs/id"},
    "schema_version": {"$ref": "../common/definitions.schema.json#/$defs/schemaVersion"},
    "name": {"type": "string", "minLength": 1, "maxLength": 512},
    "compatibility_hash": {"$ref": "../common/definitions.schema.json#/$defs/sha256"},
    "source_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../common/definitions.schema.json#/$defs/id"}},
    "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../common/definitions.schema.json#/$defs/id"}},
    "location_strategy": {"type": "object"},
    "verification_plan": {"type": "object", "required": ["checks"], "properties": {"checks": {"type": "array", "minItems": 1, "items": {"type": "object"}}}, "additionalProperties": false},
    "known_failure_modes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
