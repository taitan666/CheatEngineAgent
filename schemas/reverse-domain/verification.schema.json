{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/reverse-domain/verification.schema.json",
  "title": "Reverse Verification Run",
  "type": "object",
  "required": ["id", "schema_version", "experiment_ref", "recipe_ref", "target", "outcome", "checks"],
  "properties": {
    "id": {"$ref": "../common/definitions.schema.json#/$defs/id"},
    "schema_version": {"$ref": "../common/definitions.schema.json#/$defs/schemaVersion"},
    "experiment_ref": {"$ref": "../common/definitions.schema.json#/$defs/id"},
    "recipe_ref": {"$ref": "../common/definitions.schema.json#/$defs/id"},
    "target": {"type": "object", "required": ["process_identity_ref", "epoch"], "properties": {"process_identity_ref": {"$ref": "../common/definitions.schema.json#/$defs/id"}, "epoch": {"$ref": "../common/definitions.schema.json#/$defs/epoch"}}, "additionalProperties": false},
    "outcome": {"enum": ["pending", "pass", "fail", "inconclusive", "unknown"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "outcome", "evidence_refs"], "properties": {"name": {"type": "string", "minLength": 1}, "outcome": {"enum": ["pass", "fail", "inconclusive", "unknown"]}, "evidence_refs": {"type": "array", "items": {"$ref": "../common/definitions.schema.json#/$defs/id"}}}, "additionalProperties": false}},
    "proof_ref": {"$ref": "../common/definitions.schema.json#/$defs/id"}
  },
  "allOf": [{"if": {"properties": {"outcome": {"enum": ["pass", "fail"]}}}, "then": {"required": ["proof_ref"]}}],
  "additionalProperties": false
}
