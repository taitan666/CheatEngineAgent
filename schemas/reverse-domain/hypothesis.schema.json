{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cheatengineagent.local/reverse-domain/hypothesis.schema.json",
  "title": "Reverse Hypothesis",
  "type": "object",
  "required": ["id", "schema_version", "experiment_ref", "statement", "candidate_ref", "evidence_refs", "confidence_basis"],
  "properties": {
    "id": {"$ref": "../common/definitions.schema.json#/$defs/id"},
    "schema_version": {"$ref": "../common/definitions.schema.json#/$defs/schemaVersion"},
    "experiment_ref": {"$ref": "../common/definitions.schema.json#/$defs/id"},
    "statement": {"type": "string", "minLength": 1},
    "candidate_ref": {"$ref": "../common/definitions.schema.json#/$defs/id"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../common/definitions.schema.json#/$defs/id"}},
    "confidence_basis": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
